#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT_DIR"

# ── 辅助函数 ─────────────────────────────────────────────────────────
info()  { echo "✅ $*"; }
warn()  { echo "⚠️  $*"; }
die()   { echo "❌ $*" >&2; exit 1; }
need()  { command -v "$1" &>/dev/null || die "缺少依赖: $1，请先安装后重试"; }

# ── 1. 检查基础运行时 ────────────────────────────────────────────────
info "正在检查运行环境..."
need curl

# Rust / Cargo
if ! command -v cargo &>/dev/null; then
  warn "未检测到 Rust，正在通过 rustup 安装..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --quiet
  # 载入 cargo 到当前 shell
  # shellcheck source=/dev/null
  source "$HOME/.cargo/env"
fi
info "Rust $(rustc --version)"

# Node.js
if ! command -v node &>/dev/null; then
  warn "未检测到 Node.js，请手动安装 Node.js 18+ 后重试。"
  warn "推荐使用 nvm: https://github.com/nvm-sh/nvm"
  exit 1
fi
info "Node.js $(node --version)"

# npm
need npm

# ── 2. 检查并安装 Tauri CLI ──────────────────────────────────────────
if ! command -v cargo-tauri &>/dev/null; then
  warn "未检测到 cargo-tauri，正在通过 cargo 安装..."
  cargo install tauri-cli --locked
fi
info "Tauri CLI $(cargo tauri --version 2>/dev/null || echo 'OK')"

# ── 3. 安装 Node 依赖（如果存在 package.json）──────────────────────
if [ -f "$ROOT_DIR/package.json" ]; then
  if [ ! -d "$ROOT_DIR/node_modules" ]; then
    warn "node_modules 不存在，正在执行 npm install..."
    npm install
  fi
  info "Node 依赖已就绪"
fi

# ── 4. 启动开发服务器 ────────────────────────────────────────────────
info "启动 Tauri 开发服务器..."
cargo tauri dev --config src-tauri/tauri.conf.json
